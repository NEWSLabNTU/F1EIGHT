<?xml version="1.0"?>
<!--
  Marker survey: drive the car around the room, get the course's marker map.
  `just aruco-map scan COURSE_DIR ORIGIN_ID`.

    ZED X Mini (rectified image + positional tracking)
      -> marker_survey: detects every marker, places it live (~/markers in
         RViz), and at the end bundle-adjusts the recording
      -> COURSE_DIR/course.yaml (markers in the frame of marker ORIGIN_ID),
         lanelet2_map.osm, ar_tag.param.yaml, survey_report.yaml,
         survey_data.npz
      -> /marker_survey/debug/image: the frames with the detections drawn
         (viewer:=true opens rqt_image_view on it)

  With launch_camera:=false it runs the survey node alone, for a recorded bag
  (ros2 bag play ... with the image, camera_info, the ZED odometry and
  /tf_static) and use_sim_time:=true.

  The car's own stack is not needed: only its URDF (base_link to the camera,
  which is where the floor is) and the camera. Push it, or drive it with the
  transmitter.
-->
<launch>
  <arg name="origin_id" description="the marker that defines the course frame"/>
  <arg name="course_dir" description="where to write the course (created if new; an existing course.yaml keeps everything but its markers)"/>
  <arg name="dictionary" default="DICT_5X5_1000" description="the printed markers' family: DICT_5X5_1000 (the lab's boards) or ARUCO_MIP_36h12"/>
  <arg name="marker_size" default="0.4667"
       description="[m] edge of the BLACK SQUARE (not the board): measure it. The lab's boards, a 7x7-cell DICT_5X5_1000 marker with one cell of white margin on a 600 mm board: 0.4667 (default; W x 7/9 for a W board)"/>
  <arg name="floor_offset" default="0.0"
       description="[m] how far the floor lies below base_link: 0 on the floor, the stand height if the car's wheels are off the floor"/>
  <arg name="launch_camera" default="true" description="false: survey a bag instead"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="compressed" default="false" description="subscribe to the compressed image (a bag recorded that way)"/>
  <arg name="viewer" default="false"
       description="true: open rqt_image_view on the detections (needs a display); `just aruco-map scan` sets it when DISPLAY is set"/>
  <arg name="viewer_display" default="$(env DISPLAY '')"
       description="the X display the viewer opens on; `just aruco-map scan` passes it, because the launch itself runs without DISPLAY (the ZED cannot have one)"/>
  <arg name="vehicle_model" default="autosdv_vehicle"/>
  <arg name="sensor_model" default="autosdv_sensor_kit"/>
  <arg name="vehicle_id"
       description="REQUIRED: which car, car_a, car_b or car_c: individual_params/config/VEHICLE_ID (the ZED's mounting, from the sensor kit calibration)"/>

  <group if="$(var launch_camera)">
    <!-- base_link -> sensor kit -> zedxm_camera_link, from the vehicle URDF -->
    <include file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="launch_vehicle_interface" value="false"/>
      <arg name="config_dir" value="$(find-pkg-share individual_params)/config/$(var vehicle_id)/$(var sensor_model)"/>
    </include>
    <!-- zedxm_camera_link -> the lens and optical frames, from the ZED URDF -->
    <include file="$(find-pkg-share autosdv_sensor_kit_launch)/launch/zed_tf_only.launch.xml">
      <arg name="camera_name" value="zedxm"/>
      <arg name="camera_model" value="zedxm"/>
    </include>
    <include file="$(find-pkg-share autosdv_waypoint_lab)/launch/zed_aruco.launch.xml">
      <arg name="config" value="$(find-pkg-share autosdv_marker_survey)/config/zed_survey.yaml"/>
    </include>
  </group>

  <node pkg="autosdv_marker_survey" exec="marker_survey" name="marker_survey" output="screen">
    <param name="origin_id" value="$(var origin_id)"/>
    <param name="course_dir" value="$(var course_dir)"/>
    <param name="dictionary" value="$(var dictionary)"/>
    <param name="marker_size" value="$(var marker_size)"/>
    <param name="floor_offset" value="$(var floor_offset)"/>
    <param name="compressed" value="$(var compressed)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- the processed frames with the detections drawn: green known, yellow new,
       red too small; the origin outlined thicker -->
  <node pkg="rqt_image_view" exec="rqt_image_view" name="survey_viewer"
        args="/marker_survey/debug/image" if="$(var viewer)">
    <env name="DISPLAY" value="$(var viewer_display)"/>
  </node>
</launch>
