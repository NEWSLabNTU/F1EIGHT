<?xml version="1.0"?>
<!--
  ArUco localization: ArUco markers on a surveyed marker map fused with
  odometry in Autoware's EKF. Used by `just aruco-map check` and `align`,
  and by Lab 2's waypoint stack (autosdv_launch waypoint_follow.launch.xml).
  Stock Autoware nodes (the AR-tag localizer is AutoSDV's fork, which adds a
  `dictionary` parameter), wired here instead of
  through tier4_localization_launch, which brings NDT, pose_initializer and
  the full sensing chain with it.

    /map/vector_map (lanelet2, marker polygons only)  <- lanelet2_map_loader
                                                         + map_projection_loader (local)
    camera image + camera_info -> ar_tag_based_localizer
        -> /localization/pose_estimator/pose_with_covariance
           (use_ar_tag_localizer:=false on the bench: virtual_marker_localizer
            publishes this topic instead)
    /vehicle/status/velocity_status -> vehicle_velocity_converter
    /sensing/imu/imu_data + that twist -> gyro_odometer
        -> /localization/twist_estimator/twist_with_covariance
    ekf_localizer (pose + twist) -> /localization/kinematic_state, TF map->base_link
    twist2accel -> /localization/acceleration
    start_pose_init -> the EKF's initial pose (course.yaml start_pose: the taped
                       start box, or where a survey's recording started)

  No stop_filter: the EKF's odometry goes straight to kinematic_state. Its
  only job in stock Autoware is to zero a near-zero velocity, which nothing
  in the ArUco stack depends on.
-->
<launch>
  <arg name="course_dir" description="the marker map: course.yaml, lanelet2_map.osm, ar_tag.param.yaml, map_projector_info.yaml (a survey directory, or a Lab 2 course)"/>
  <arg name="use_ar_tag_localizer" default="true"
       description="false on the bench, where virtual_marker_localizer stands in for the camera and the localizer"/>
  <arg name="image_topic" default="/sensing/camera/zedxm/rgb/color/rect/image"/>
  <arg name="camera_info_topic" default="/sensing/camera/zedxm/rgb/color/rect/camera_info"/>
  <arg name="ar_tag_param_file" default="$(find-pkg-share autosdv_aruco_localization)/config/ar_tag_based_localizer.param.yaml"/>
  <arg name="ar_tag_container" default=""
       description="load the localizer into this container (the ZED's) instead of its own process; empty: its own process"/>
  <arg name="ekf_param_file" default="$(find-pkg-share autoware_launch)/config/localization/ekf_localizer.param.yaml"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="launch_start_pose_init" default="true"
       description="false: something else seeds the EKF (`just aruco-map align` seeds it from the markers it sees)"/>

  <let name="lanelet2_map_path" value="$(var course_dir)/lanelet2_map.osm"/>

  <group>
    <push-ros-namespace namespace="map"/>
    <node pkg="autoware_map_projection_loader" exec="autoware_map_projection_loader_node"
          name="map_projection_loader" output="screen">
      <param name="map_projector_info_path" value="$(var course_dir)/map_projector_info.yaml"/>
      <param name="lanelet2_map_path" value="$(var lanelet2_map_path)"/>
    </node>
    <node pkg="autoware_map_loader" exec="autoware_lanelet2_map_loader"
          name="lanelet2_map_loader" output="screen">
      <param name="allow_unsupported_version" value="true"/>
      <param name="center_line_resolution" value="5.0"/>
      <param name="use_waypoints" value="true"/>
      <param name="lanelet2_map_path" value="$(var lanelet2_map_path)"/>
      <remap from="output/lanelet2_map" to="vector_map"/>
    </node>
  </group>

  <group>
    <push-ros-namespace namespace="localization"/>

    <group>
      <push-ros-namespace namespace="pose_estimator"/>
      <!-- In the camera's container: a 1920x1200 RGB frame is 6.9 MB, and at
           15 Hz that is 100 MB/s through UDP to a separate process, which a
           best-effort subscription (the localizer's) loses fragments of under
           load. In the same process the nodes share one DDS participant and
           CycloneDDS delivers locally, with no network path. Not
           use_intra_process_comms: the localizer's map subscription is
           transient-local, which Humble's intra-process refuses. -->
      <load_composable_node target="$(var ar_tag_container)"
                            if="$(eval &quot;'$(var use_ar_tag_localizer)' == 'true' and '$(var ar_tag_container)' != ''&quot;)">
        <composable_node pkg="autoware_ar_tag_based_localizer" plugin="ArTagBasedLocalizer"
                         name="ar_tag_based_localizer" namespace="/localization/pose_estimator">
          <remap from="~/input/lanelet2_map" to="/map/vector_map"/>
          <remap from="~/input/image" to="$(var image_topic)"/>
          <remap from="~/input/camera_info" to="$(var camera_info_topic)"/>
          <remap from="~/input/ekf_pose" to="/localization/pose_twist_fusion_filter/biased_pose_with_covariance"/>
          <remap from="~/output/pose_with_covariance" to="/localization/pose_estimator/pose_with_covariance"/>
          <param from="$(var ar_tag_param_file)"/>
          <param from="$(var course_dir)/ar_tag.param.yaml" allow_substs="true"/>
          <extra_arg name="use_intra_process_comms" value="false"/>
        </composable_node>
      </load_composable_node>
      <!-- The stock launch file's node, spelled out: that file takes one
           param file, and the course's marker settings are a second. -->
      <node pkg="autoware_ar_tag_based_localizer" exec="autoware_ar_tag_based_localizer_node"
            name="ar_tag_based_localizer" output="both"
            if="$(eval &quot;'$(var use_ar_tag_localizer)' == 'true' and '$(var ar_tag_container)' == ''&quot;)">
        <remap from="~/input/lanelet2_map" to="/map/vector_map"/>
        <remap from="~/input/image" to="$(var image_topic)"/>
        <remap from="~/input/camera_info" to="$(var camera_info_topic)"/>
        <remap from="~/input/ekf_pose" to="/localization/pose_twist_fusion_filter/biased_pose_with_covariance"/>
        <remap from="~/output/pose_with_covariance" to="/localization/pose_estimator/pose_with_covariance"/>
        <param from="$(var ar_tag_param_file)"/>
        <param from="$(var course_dir)/ar_tag.param.yaml" allow_substs="true"/>
      </node>
    </group>

    <group>
      <push-ros-namespace namespace="twist_estimator"/>
      <!-- each include in its own group: both declare config_file, and an
           include's arguments otherwise leak into the next one -->
      <group>
      <include file="$(find-pkg-share autoware_vehicle_velocity_converter)/launch/vehicle_velocity_converter.launch.xml">
        <arg name="input_vehicle_velocity_topic" value="/vehicle/status/velocity_status"/>
        <arg name="output_twist_with_covariance" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
      </include>
      </group>
      <group>
      <include file="$(find-pkg-share autoware_gyro_odometer)/launch/gyro_odometer.launch.xml">
        <arg name="input_vehicle_twist_with_covariance_topic" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
        <arg name="input_imu_topic" value="/sensing/imu/imu_data"/>
        <arg name="output_twist_with_covariance_topic" value="/localization/twist_estimator/twist_with_covariance"/>
        <arg name="output_twist_with_covariance_raw_topic" value="/localization/twist_estimator/twist_with_covariance_raw"/>
      </include>
      </group>
    </group>

    <group>
      <push-ros-namespace namespace="pose_twist_fusion_filter"/>
      <include file="$(find-pkg-share autoware_ekf_localizer)/launch/ekf_localizer.launch.xml">
        <arg name="param_file" value="$(var ekf_param_file)"/>
        <arg name="input_initial_pose_name" value="/localization/pose_twist_fusion_filter/initialpose3d"/>
        <arg name="input_trigger_node_service_name" value="/localization/pose_twist_fusion_filter/trigger_node"/>
        <arg name="input_pose_with_cov_name" value="/localization/pose_estimator/pose_with_covariance"/>
        <arg name="input_twist_with_cov_name" value="/localization/twist_estimator/twist_with_covariance"/>
        <arg name="output_odom_name" value="/localization/kinematic_state"/>
        <arg name="output_pose_name" value="pose"/>
        <arg name="output_pose_with_covariance_name" value="/localization/pose_with_covariance"/>
        <arg name="output_biased_pose_name" value="biased_pose"/>
        <arg name="output_biased_pose_with_covariance_name" value="biased_pose_with_covariance"/>
        <arg name="output_twist_name" value="twist"/>
        <arg name="output_twist_with_covariance_name" value="twist_with_covariance"/>
      </include>
      <node pkg="autosdv_aruco_localization" exec="start_pose_init" name="start_pose_init" output="screen"
            if="$(var launch_start_pose_init)">
        <param name="course_dir" value="$(var course_dir)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
      </node>
    </group>

    <group>
    <include file="$(find-pkg-share autoware_twist2accel)/launch/twist2accel.launch.xml">
      <arg name="in_odom" value="/localization/kinematic_state"/>
      <arg name="in_twist" value="/localization/twist_estimator/twist_with_covariance"/>
      <arg name="out_accel" value="/localization/acceleration"/>
    </include>
    </group>
  </group>
</launch>
