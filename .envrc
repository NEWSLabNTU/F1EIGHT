#!/bin/bash
# AutoSDV environment configuration for direnv.
#
# Without direnv, this is still the file to read, and `source .envrc` gets you
# most of the way (the PATH_add and watch_file lines are direnv's and will not
# resolve; scripts/env.sh is the plain-bash equivalent for the sourcing part).
#
# This file owns one decision nothing else should make: which middleware runs.

# ---- middleware ----------------------------------------------------------
# This file, and only this file, sets the middleware -- not ~/.bashrc, not
# scripts/env.sh. Entering the directory sets each variable only if it is not
# set yet: RMW_IMPLEMENTATION defaults to rmw_cyclonedds_cpp and, for Cyclone,
# CYCLONEDDS_URI to this repository's cyclonedds.xml, which pins DDS to
# loopback. A choice made before entering is kept:
#
#     RMW_IMPLEMENTATION=rmw_zenoh_cpp direnv reload
#
# Autoware does not choose for you: the 1.5.0 Debian's setup.bash exports no
# RMW, only ROS_LOCALHOST_ONLY=0, so a shell without this file runs Humble's
# default Fast DDS on every interface, the cars' shared Wi-Fi included. Some
# Autoware builds' setup.bash does export one, which is why the choice is
# recorded first and put back at the end. Every process in the graph must
# agree; two ROS 2 processes on different middlewares cannot see each other,
# and nothing reports it.
_autosdv_rmw="${RMW_IMPLEMENTATION:-}"

if [ -f /opt/autoware/1.5.0/setup.bash ]; then
    # Source Autoware 1.5.0 environment if available
    source /opt/autoware/1.5.0/setup.bash
else
    # Fallback: Manual Autoware and ROS 2 setup
    echo "=========================================="
    echo "INFO: /opt/autoware/autoware-env not found"
    echo "INFO: Please source your Autoware installation manually:"
    echo "      source \$AUTOWARE_DIR/install/setup.bash"
    echo "=========================================="

    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

    # Unset ROS_LOCALHOST_ONLY if present
    if [[ -v ROS_LOCALHOST_ONLY ]]; then
        echo 'WARNING: ROS_LOCALHOST_ONLY variable is present. Unsetting it.'
        unset ROS_LOCALHOST_ONLY
    fi

    # CycloneDDS Configuration - Check sysctl (warn once)
    # Check if values are sufficient (not exact equality)
    rmem_max=$(sysctl -n net.core.rmem_max 2>/dev/null || echo "0")
    ipfrag_time=$(sysctl -n net.ipv4.ipfrag_time 2>/dev/null || echo "999")
    ipfrag_thresh=$(sysctl -n net.ipv4.ipfrag_high_thresh 2>/dev/null || echo "0")

    if [ "$rmem_max" -lt 2147483647 ] || \
       [ "$ipfrag_time" -gt 3 ] || \
       [ "$ipfrag_thresh" -lt 134217728 ]; then
        if [ ! -f .envrc.sysctl-warned ]; then
            echo "┌────────────────────────────────────────────────────────────┐"
            echo "│ WARNING: CycloneDDS kernel buffers not configured         │"
            echo "│ You may experience packet loss with high-bandwidth data   │"
            echo "│ To fix: cd setup && just cyclonedds-sysctl                │"
            echo "└────────────────────────────────────────────────────────────┘"
            touch .envrc.sysctl-warned
        fi
    fi

    # Set CycloneDDS XML (always use project-local file)
    export CYCLONEDDS_URI="file://$(pwd)/cyclonedds.xml"

    # Source ROS 2 Humble
    source /opt/ros/humble/setup.bash
fi

# ---- CUDA toolkit ---------------------------------------------------------
# Which toolkit to use is the user's choice, resolved by the ecosystem
# convention (CMake FindCUDAToolkit, PyTorch, Numba, CuPy): CUDA_HOME, then
# CUDA_PATH, then the /usr/local/cuda symlink. Versioned directories are
# deliberately not scanned, matching Numba, because the symlink is the
# administrator's choice:
#
#     CUDA_HOME=/usr/local/cuda-12.8 direnv reload   # this workspace
#     sudo update-alternatives --config cuda         # system-wide
#
# It matters at run time, not only at build time. cuda_ndt ships no compiled
# kernels: cubecl reads the GPU's compute capability and has NVRTC compile for
# it in-process, so the *loaded* libnvrtc has to know that architecture. NVRTC
# 12.3 stops at sm_90, and on a Blackwell card (sm_120) the matcher dies with
# "invalid value for --gpu-architecture (-arch)" while the launcher reports
# every node ready. `scripts/check-cuda-arch.sh` says whether this machine's
# toolkit and GPU agree.
#
# Hence lib64 and not just bin: the library path is what selects the NVRTC that
# runs, and cudarc opens it by the plain name `libnvrtc.so`.
cuda_home="${CUDA_HOME:-${CUDA_PATH:-/usr/local/cuda}}"
if [ -d "$cuda_home" ]; then
    if [ -x "$cuda_home/bin/nvcc" ] && ! command -v nvcc >/dev/null 2>&1; then
        PATH_add "$cuda_home/bin"
    fi
    if [ -d "$cuda_home/lib64" ]; then
        export LD_LIBRARY_PATH="$cuda_home/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
fi
unset cuda_home

# Source workspace if it has been built
if [ -f install/setup.bash ]; then
    watch_file install/setup.bash
    source install/setup.bash
fi

# Put the user's middleware back, if they chose one; else the default. See the
# note at the top.
if [ -n "$_autosdv_rmw" ]; then
    export RMW_IMPLEMENTATION="$_autosdv_rmw"
else
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
fi
if [ "$RMW_IMPLEMENTATION" = rmw_cyclonedds_cpp ] && [ -z "${CYCLONEDDS_URI:-}" ]; then
    export CYCLONEDDS_URI="file://$PWD/cyclonedds.xml"
fi
unset _autosdv_rmw
