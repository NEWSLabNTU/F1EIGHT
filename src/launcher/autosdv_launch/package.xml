<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_launch</name>
  <version>0.0.0</version>
  <description>AutoSDV launch and utility package</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>rclpy</exec_depend>

  <!-- 2D-LiDAR variant: scan synthesis, occupancy grid serving, and the
       AMCL cross-check used by the localization evaluation scripts. -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Dead-reckoned stand-in for localization, for running the control chain
       without a map: the odometry node lives in autosdv_mcl_launch and
       twist2accel differentiates its output into /localization/acceleration.
       See autosdv_dead_reckoning_component.launch.xml. -->
  <exec_depend>autosdv_mcl_launch</exec_depend>
  <exec_depend>autoware_twist2accel</exec_depend>

  <!-- Lab 2 coach pursuit (coach_pursuit*.launch.xml): tracker, pursuit
       planner and the simulator stand-ins. The board detector
       (reflective_pose_ros) is deliberately not listed: it is a submodule
       built only where the vehicle launch runs, and the sim launch never
       needs it. -->
  <exec_depend>autosdv_coach_lab</exec_depend>
  <exec_depend>autosdv_lab_msgs</exec_depend>
  <!-- lab2_part1_sim.launch.xml, waypoint_follow*.launch.xml, the bench of
       aruco_survey_align.launch.xml -->
  <exec_depend>autosdv_waypoint_lab</exec_depend>
  <!-- aruco_loc_check.launch.xml, aruco_survey_align.launch.xml, waypoint_follow*.launch.xml -->
  <exec_depend>autosdv_aruco_localization</exec_depend>
  <exec_depend>autosdv_rc_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
