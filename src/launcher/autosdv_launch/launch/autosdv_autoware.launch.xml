<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- AutoSDV wrapper for autoware.launch.xml -->
  <!-- Uses autosdv_launch config instead of autoware_launch -->

  <!-- Essential parameters -->
  <arg name="map_path" description="point cloud and lanelet2 map directory path"/>
  <arg name="vehicle_model" default="sample_vehicle" description="vehicle model name"/>
  <arg name="sensor_model" default="sample_sensor_kit" description="sensor model name"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="data_path" default="$(env HOME)/autoware_data" description="packages data and artifacts directory path"/>

  <!-- launch module preset -->
  <arg name="planning_module_preset" default="default" description="planning module preset"/>
  <arg name="control_module_preset" default="default" description="control module preset"/>

  <!-- Optional parameters -->
  <!-- Modules to be launched -->
  <arg name="launch_vehicle" default="true" description="launch vehicle"/>
  <arg name="launch_system" default="true" description="launch system"/>
  <arg name="launch_map" default="true" description="launch map"/>
  <arg name="launch_sensing" default="true" description="launch sensing"/>
  <arg name="launch_sensing_driver" default="true" description="launch sensing driver"/>
  <arg name="launch_localization" default="true" description="launch localization"/>
  <arg name="launch_perception" default="true" description="launch perception"/>
  <arg name="use_mapless_mode" default="false" description="operate without a map or localization; perception runs in base_link"/>
  <arg name="launch_planning" default="true" description="launch planning"/>
  <arg name="launch_control" default="true" description="launch control"/>
  <arg name="launch_api" default="true" description="launch api"/>
  <!-- AutoSDV: the shared pointcloud_container was started unconditionally.
       A stack with no sensing-side preprocessing and no Autoware perception
       (the coach-pursuit lab) leaves it hosting only a glog component. -->
  <arg name="launch_shared_pointcloud_container" default="true" description="start the shared pointcloud_container"/>
  <!-- Global parameters -->
  <arg name="use_sim_time" default="false" description="use_sim_time"/>
  <!-- Localization -->
  <arg name="pose_source" default="ndt" description="select pose_estimator: ndt, yabloc, eagleye"/>
  <arg name="pose_source_package" default="cuda_ndt_matcher_launch" description="External package replacing built-in NDT node"/>
  <!-- AutoSDV: declared so the localization include below can forward it.
       Previously this arrived only through LaunchConfiguration leakage from
       autosdv.launch.yaml, and localization never saw it at all: the pose
       initializer kept the upstream gnss_enabled default of true under
       use_gnss:=false. Empty means the sensor suite decides. -->
  <arg name="use_gnss" default="" description="GNSS available; empty means the sensor suite decides"/>
  <!-- AutoSDV: the two CUDA pipeline switches. pointcloud_backend reaches the
       sensor kit the way lidar_model does, through the stock sensing chain's
       launch configurations; localization_pointcloud_backend is forwarded
       explicitly to the localization component below. -->
  <arg name="pointcloud_backend" default="cpu" description="cpu or cuda: sensing-side point cloud preprocessing"/>
  <arg name="localization_pointcloud_backend" default="cpu" description="cpu or cuda: the NDT input preprocessing chain"/>

  <!-- AutoSDV: retarget map_height_fitter (used by autoware_pose_initializer
       for GNSS auto-init, and by the RViz initial-pose adaptor for "2D Pose
       Estimate") away from the PCD when pose_source:=mcl. Its default
       target is "pointcloud_map", fed by pointcloud_map_loader; the mcl map
       component (autosdv_map_component) never starts that loader, so
       map_height_fitter's constructor blocks forever in
       wait_for_service(/map/pointcloud_map_loader) ; reproduced
       empirically: pose_initializer never leaves that state, so neither
       init route ever produces /initialpose3d. Retarget both consumers at
       "vector_map" (the lanelet2 map) instead: it is always published
       regardless of pose_source, and for a planar 2-D filter the height it
       reports (the nearest lanelet point's z) is as meaningful as any other
       choice. Neither pose_initializer.launch.xml nor
       rviz_adaptors.launch.xml is AutoSDV/fork-owned, and both declare
       their target arg with a plain default (not a required arg), so this
       is set once here, globally, rather than threaded explicitly through
       the several stock includes between here and them, using the same
       mechanism that already carries pose_source/twist_source/
       system_run_mode down to pose_twist_estimator.launch.xml without
       being re-declared at every hop. -->
  <let name="gnss_initial_pose_auto_fix_target" value="$(eval &quot;'vector_map' if '$(var pose_source)' == 'mcl' else 'pointcloud_map'&quot;)"/>
  <let name="rviz_initial_pose_auto_fix_target" value="$(var gnss_initial_pose_auto_fix_target)"/>

  <!-- Vehicle -->
  <arg name="vehicle_id" description="REQUIRED: which car (individual_params/config/VEHICLE_ID); autosdv.launch.yaml and the sims pass it, no environment fallback"/>
  <arg name="launch_vehicle_interface" default="true" description="launch vehicle interface"/>
  <!-- Control -->
  <arg name="check_external_emergency_heartbeat" default="false"/>
  <!-- Map -->
  <arg name="lanelet2_map_file" default="lanelet2_map.osm" description="lanelet2 map file name"/>
  <arg name="pointcloud_map_file" default="pointcloud_map.pcd" description="pointcloud map file name"/>
  <!-- AutoSDV: occupancy_grid_file was not forwarded (autosdv_map_component's
       own default, occupancy_grid.yaml, always won regardless of what a
       caller wanted) - exposed here for pose_source:=mcl. Every Phase 4
       accuracy result used occupancy_grid_scanaccum_mh1r05.yaml (Lever-2,
       0.05 m/cell), not the coarser default occupancy_grid.yaml
       (0.2 m/cell, 4.7M unknown cells raycast as free in range_libc - see
       docs/research/localization/2d_mcl_algorithm.md Sec 5.2). Confirmed via
       Task 8 end-to-end diagnosis: with the default grid, GT-vs-filter
       trans. mean was 2.6-5.4 m; not forwarding this argument was the
       reason nobody could reach the Phase 4 grid from `just launch`.
       Default stays occupancy_grid.yaml (unchanged, still deliberately
       neutral - see the Task 8 report for why) so this is additive, not a
       behavior change for anyone not naming the argument. -->
  <arg name="occupancy_grid_file" default="occupancy_grid.yaml" description="2-D occupancy grid metadata file name (pose_source:=mcl only); Phase 4's validated accuracy used occupancy_grid_scanaccum_mh1r05.yaml, not this default -- see docs/reports/2dlidar-phase5-mcl-pose-source.md"/>
  <arg name="mcl_random_seed" default="-1" description="particle_filter RNG seed (pose_source:=mcl only); -1 = nondeterministic, which is the operational default; set one per run for a reproducible accuracy matrix"/>
  <!-- AutoSDV: the LiDAR topic the localization util chain (voxel downsample
       -> NDT) consumes. The default is the concatenated cloud a live sensing
       pipeline produces, which a replayed bag does not have: the sample bag
       carries /sensing/lidar/top/pointcloud_raw_ex only. Previously this was
       declared in tier4_localization_component but never forwarded from here,
       so it could not be set from the command line at all, and NDT silently
       received no scan; pose_initializer then failed with "align server
       failed" on every attempt. -->
  <arg name="input_pointcloud" default="/sensing/lidar/concatenated/pointcloud" description="LiDAR topic feeding the localization util chain (ndt/cuda_ndt); set to the bag topic for logging simulation"/>
  <!-- AutoSDV: the same problem one module across. perception.launch.xml also
       defaults to the concatenated cloud, and the stock perception component
       does not expose the argument at all, so replaying a bag left perception
       with no input: no obstacle segmentation, no occupancy grid, and
       behavior_path_planner stuck at "waiting for occupancy_grid" publishing no
       path or trajectory. Kept separate from input_pointcloud because the two
       modules can legitimately consume different clouds. -->
  <arg name="perception_input_pointcloud" default="/sensing/lidar/concatenated/pointcloud" description="LiDAR topic feeding perception; set to the bag topic for logging simulation"/>
  <!-- System -->
  <arg name="system_run_mode" default="online" description="run mode in system"/>
  <arg name="launch_system_monitor" default="true" description="launch system monitor"/>
  <arg name="launch_dummy_diag_publisher" default="false" description="launch dummy diag publisher"/>
  <!-- AutoSDV: the runtime health checks that gate autonomous mode are
       method-dependent, because pose_source:=mcl deliberately has no PCD map
       and no ndt_scan_matcher. With the stock graph, /autoware/map requires
       /map/pointcloud_map and /autoware/localization requires
       ndt_scan_matcher's scan_matching_status; under mcl neither can ever
       report, so /autoware/modes/autonomous is permanently unavailable no
       matter how good the pose is. Measured on the sample site: localization
       INITIALIZED and route SET, yet change_to_autonomous returns "The target
       mode is not available" with those two among the aggregator's stated
       reasons. Resolve both config paths from pose_source; every non-mcl
       method keeps the stock files byte for byte. See
       docs/design/map-handling-per-localization-method.md. -->
  <let name="diagnostic_graph_default"
       value="$(eval &quot;'$(find-pkg-share autosdv_launch)/config/system/diagnostics/autosdv-mcl-main.yaml' if '$(var pose_source)' == 'mcl' else '$(find-pkg-share autoware_launch)/config/system/diagnostics/autoware-main.yaml'&quot;)"/>
  <!-- AutoSDV: an empty value means "resolve from pose_source", so a parent
       launch can forward the argument unconditionally (autosdv.launch.yaml
       does, defaulting to empty) and a lab launch can name its own graph
       (coach_pursuit.launch.xml, autosdv-pursuit-main.yaml). -->
  <arg name="diagnostic_graph_aggregator_graph_path" default="" description="diagnostic graph config; empty resolves it from pose_source"/>
  <let name="resolved_diagnostic_graph_path" value="$(eval &quot;'$(var diagnostic_graph_aggregator_graph_path)' or '$(var diagnostic_graph_default)'&quot;)"/>
  <let name="component_state_monitor_topic_default"
       value="$(eval &quot;'$(find-pkg-share autosdv_launch)/config/system/component_state_monitor/topics-mcl.yaml' if '$(var pose_source)' == 'mcl' else '$(find-pkg-share autosdv_launch)/config/system/component_state_monitor/topics.yaml'&quot;)"/>
  <arg name="component_state_monitor_topic_path" default="" description="component state monitor topic list; empty resolves it from pose_source"/>
  <let name="resolved_component_state_monitor_topic_path" value="$(eval &quot;'$(var component_state_monitor_topic_path)' or '$(var component_state_monitor_topic_default)'&quot;)"/>
  <!-- Tools -->
  <arg name="rviz" default="true" description="launch rviz"/>
  <arg name="rviz_config_name" default="autoware.rviz" description="rviz config name"/>
  <arg name="rviz_config" default="$(find-pkg-share autoware_launch)/rviz/$(var rviz_config_name)" description="rviz config path"/>
  <arg name="rviz_respawn" default="true"/>
  <arg name="viewer_display" default="$(env DISPLAY '')"
       description="the X display RViz opens on. A launch that opens the ZED runs without DISPLAY (scripts/testing/lab2/camera_display.sh) and hands the viewer its display here (just lab2 stack)"/>
  <!-- Perception -->
  <arg name="perception_mode" default="lidar" description="select perception mode. camera_lidar_radar_fusion, camera_lidar_fusion, lidar_radar_fusion, lidar, radar"/>
  <arg name="traffic_light_recognition/enable_fine_detection" default="true" description="enable traffic light fine detection"/>
  <arg name="use_pointcloud_map" default="true" description="use pointcloud map in perception (compare-map filter). Forced false when pose_source is mcl, since the mcl map component does not load a PCD"/>
  <!-- Auto mode setting-->
  <arg name="enable_all_modules_auto_mode" default="false" description="enable all module's auto mode"/>
  <arg name="is_simulation" default="false" description="Autoware's behavior will change depending on whether this is a simulation or not."/>

  <!-- Global parameters -->
  <group scoped="false">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Pointcloud container -->
  <!-- Not wrapped in a group, and must not be: an unscoped include leaks its
       arguments, and use_multithread:=true from here is what makes the map
       component's container component_container_mt further down. -->
  <include file="$(find-pkg-share autoware_launch)/launch/pointcloud_container.launch.py" if="$(var launch_shared_pointcloud_container)">
    <arg name="use_multithread" value="true"/>
    <arg name="container_name" value="$(var pointcloud_container_name)"/>
  </include>

  <!-- Vehicle -->
  <group if="$(var launch_vehicle)">
    <include file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
      <arg name="config_dir" value="$(find-pkg-share individual_params)/config/$(var vehicle_id)/$(var sensor_model)"/>
      <!-- AutoSDV: Use autosdv_launch config for vehicle parameters -->
      <arg name="raw_vehicle_cmd_converter_param_path" value="$(find-pkg-share autosdv_launch)/config/vehicle/raw_vehicle_cmd_converter/raw_vehicle_cmd_converter.param.yaml"/>
    </include>
  </group>

  <!-- System -->
  <group if="$(var launch_system)">
    <!-- AutoSDV: forward both health-check config paths. The stock include
         passed no arguments, so tier4_system_component resolved its own
         defaults and every file under autosdv_launch/config/system was dead
         config ; including a trajectory-topic fix that therefore never
         applied. -->
    <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_system_component.launch.xml">
      <arg name="diagnostic_graph_aggregator_graph_path" value="$(var resolved_diagnostic_graph_path)"/>
      <arg name="component_state_monitor_topic_path" value="$(var resolved_component_state_monitor_topic_path)"/>
          <arg name="use_sim_time" value="$(var use_sim_time)"/>
</include>
  </group>

  <!-- Map -->
  <!-- AutoSDV: method-aware map component. The stock component starts
       pointcloud_map_loader unconditionally, which is fatal when there is no
       PCD (pose_source:=mcl). See docs/design/map-handling-per-localization-method.md -->
  <group if="$(var launch_map)">
    <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_map_component.launch.xml">
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="lanelet2_map_file" value="$(var lanelet2_map_file)"/>
      <arg name="pointcloud_map_file" value="$(var pointcloud_map_file)"/>
      <arg name="occupancy_grid_file" value="$(var occupancy_grid_file)"/>
      <arg name="pose_source" value="$(var pose_source)"/>
          <arg name="use_sim_time" value="$(var use_sim_time)"/>
</include>
  </group>

  <!-- Sensing -->
  <group if="$(var launch_sensing)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_sensing_component.launch.xml">
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="launch_sensing_driver" value="$(var launch_sensing_driver)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Localization -->
  <!-- AutoSDV: Use autosdv_launch's localization component with custom config -->
  <group if="$(var launch_localization)">
    <include file="$(find-pkg-share autosdv_launch)/launch/components/tier4_localization_component.launch.xml">
      <arg name="pose_source" value="$(var pose_source)"/>
      <arg name="pose_source_package" value="$(var pose_source_package)"/>
      <arg name="mcl_random_seed" value="$(var mcl_random_seed)"/>
      <arg name="input_pointcloud" value="$(var input_pointcloud)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="use_gnss" value="$(var use_gnss)"/>
      <arg name="localization_pointcloud_backend" value="$(var localization_pointcloud_backend)"/>
    </include>
  </group>

  <!-- Perception -->
  <!-- AutoSDV: explicitly declare and forward use_pointcloud_map. Previously
       this include did not declare/forward the arg at all, so whether the
       perception preset's value reached tier4_perception_component depended
       on ROS 2 launch's global LaunchConfiguration leakage across <include>
       boundaries (works today from autosdv.launch.yaml/logging_simulation
       .launch.yaml, which happen to declare it earlier in the same tree, but
       is fragile and undocumented) rather than an explicit contract. Forcing
       it false for pose_source:=mcl is a genuine gap either way: nothing
       today ties use_pointcloud_map to pose_source, so with any preset that
       defaults it true (e.g. lidar_only), voxel_based_compare_map_filter is
       still loaded under mcl even though the mcl map component
       (autosdv_map_component) never publishes a PCD for it to filter
       against; confirmed empirically: it loads but never completes
       initialization (LOADED event never received, node absent from `ros2
       node list`). See docs/design/map-handling-per-localization-method.md
       section 1. -->
  <let name="resolved_use_pointcloud_map" value="$(eval &quot;'$(var use_pointcloud_map)' if '$(var pose_source)' != 'mcl' and '$(var use_mapless_mode)' != 'true' else 'false'&quot;)"/>
  <group if="$(var launch_perception)">
    <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_perception_component.launch.xml">
      <arg name="data_path" value="$(var data_path)"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="use_pointcloud_map" value="$(var resolved_use_pointcloud_map)"/>
      <arg name="input/pointcloud" value="$(var perception_input_pointcloud)"/>
      <arg name="use_mapless_mode" value="$(var use_mapless_mode)"/>
          <arg name="use_sim_time" value="$(var use_sim_time)"/>
</include>
  </group>

  <!-- Planning -->
  <group if="$(var launch_planning)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_planning_component.launch.xml">
      <arg name="module_preset" value="$(var planning_module_preset)"/>
      <arg name="enable_all_modules_auto_mode" value="$(var enable_all_modules_auto_mode)"/>
      <arg name="is_simulation" value="$(var is_simulation)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>

    <!-- Relay node for trajectory topic -->
    <!-- This is a temporary addition for migration purposes. -->
    <!-- https://github.com/orgs/autowarefoundation/discussions/5033#discussioncomment-13704802 -->
    <node pkg="topic_tools" exec="relay" name="trajectory_relay">
      <param name="input_topic" value="/planning/trajectory"/>
      <param name="output_topic" value="/planning/scenario_planning/trajectory"/>
    </node>
  </group>

  <!-- Control -->
  <group if="$(var launch_control)">
    <include file="$(find-pkg-share autoware_launch)/launch/components/tier4_control_component.launch.xml">
      <arg name="module_preset" value="$(var control_module_preset)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- API. AutoSDV: our fork of tier4_autoware_api_component, without the
       vehicle door adapter (the vehicle has no doors). -->
  <group if="$(var launch_api)">
    <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_api_component.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>

  <!-- Tools -->
  <group>
    <node
      pkg="rviz2"
      exec="rviz2"
      name="rviz2"
      output="screen"
      args="-d $(var rviz_config) -s $(find-pkg-share autoware_launch)/rviz/image/autoware.png"
      if="$(var rviz)"
      respawn="$(var rviz_respawn)"
    >
      <env name="QT_QPA_PLATFORMTHEME" value="qt5ct"/>
      <env name="DISPLAY" value="$(var viewer_display)"/>
    </node>
  </group>
</launch>
