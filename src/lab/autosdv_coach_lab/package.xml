<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_coach_lab</name>
  <version>0.1.0</version>
  <description>
    Lab 2, coach-board pursuit: coach_tracker (board pose to CoachState),
    board_pursuit_planner (loads the student CruiseController and publishes
    /planning/trajectory in place of Autoware planning), and the simulator
    stand-ins virtual_coach, drive_gear_hold and sim_pose_init.
  </description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>autosdv_lab_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>autoware_adapi_v1_msgs</depend>
  <!-- field calibration tools (autosdv_coach_lab.calibration) -->
  <depend>autosdv_vehicle_interface</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_internal_debug_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
