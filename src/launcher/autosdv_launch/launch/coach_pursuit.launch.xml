<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lab 2, Part 2: coach-board pursuit on the vehicle. `just lab2 vehicle`.

    LiDAR -> board_tracking (reflective_pose_ros)   -> /perception/coach/board
          -> coach_tracker                          -> /perception/coach/state
          -> board_pursuit_planner + CruiseController -> /planning/trajectory
          -> Autoware control (pure_pursuit + PID)  -> /control/command/control_cmd
          -> actuator (speed PID)                   -> PWM
    velocity_report + IMU -> dead reckoning -> /localization/kinematic_state

  autosdv.launch.yaml with map, localization, perception, planning, and
  Autoware's stock control, system and AD API switched off. In their place:

    autosdv_dead_reckoning_component  the odometry vehicle_cmd_gate needs
    autosdv_pursuit_control_component pure_pursuit + PID, the gate, the
                                      operation mode manager, the selector
    autosdv_pursuit_system_component  the diagnostic graph, its rate monitors,
                                      the MRM handler and operators
    autosdv_pursuit_api_component     ADAPI operation_mode and mrm_request
    autosdv-pursuit-main.yaml         the diagnostic graph that lets engage
                                      succeed without a route or a map

  Everything the lab does not use is off (44 nodes, from 83; 2026-10-11).
  Each component file says what it keeps and why; the rest, with the reason:

    AD API: 16 of 19 default adapters, the RViz pose/route adaptors and the
      RTC controller: no lab node calls or reads them
    system: StateMonitor, processing_time_checker, pipeline_latency_monitor,
      service_log_checker, hazard_status_converter: no lab graph unit or
      node reads them
    control: external_cmd_converter (manual modes only; marked unavailable in
      control-pursuit.yaml), control_validator, shift_decider, the check
      container and its glog components
    sensing: the pointcloud_container and passthrough_as_concatenate (the
      detector reads the driver's cloud), vehicle_velocity_converter (fed
      gyro_odometer; dead reckoning reads velocity_status), gyro_bias_estimator
      (a diagnostic nothing reads)
    vehicle: signal_manager (turn-indicator status; nothing reads it)
    perception: empty_objects_publisher (fed Autoware planning)

  control_mode_manager also stops publishing /system/operation_mode/availability:
  the graph converter owns that topic, and a second, always-"available"
  publisher on it can hide a failed check from the MRM handler and engage.

  What runs and why: docs/guides/lab2-stack.md.

  Safety lives outside this file and must be in place first: the physical kill
  switch, the actuator watchdog, and the planner's standoff floor and speed cap
  (autosdv_coach_lab/config/board_pursuit_planner.param.yaml).

  Design: docs/design/coach-cruise-lab.md (no-localization analysis) and the
  Lab 2 plan in the course repository.
-->
<launch>
  <!-- the car -->
  <arg name="sensor_suite" default="vlp32c_zed_imu"
       description="autosdv.launch.yaml sensor suite"/>
  <!-- Lab 2 runs on Robin-W cars with the ZED's built-in IMU (decided
       2026-10-11). vlp16 still works for testing: pass lidar_model:=vlp16. -->
  <arg name="lidar_model" default="robin-w" description="robin-w (the Lab 2 cars) or vlp16; overrides the suite's"/>
  <arg name="imu_source" default="zed" description="zed (the ZED's IMU, camera streams off) or mpu9250"/>
  <arg name="imu_yaw_sign" default="1.0"
       description="dead reckoning yaw sign; MEASURE it per car (coach-cruise-lab.md 3.2)"/>
  <arg name="rviz" default="false"/>

  <!-- the student's law -->
  <arg name="controller_class" default="autosdv_coach_lab.reference.cruise_controller:CruiseController"/>
  <arg name="controller_param_file" default=""/>
  <arg name="launch_planner" default="true"
       description="false: no board_pursuit_planner; run the speed step test (just lab2 speed-steps) in its place"/>

  <!-- the student's inner loop: the actuator's speed-controller plug-in -->
  <arg name="speed_controller_class"
       default="autosdv_vehicle_interface.speed_controller:AckermannSpeedPID"
       description="SpeedPID, package.module:ClassName"/>
  <arg name="speed_controller_params" default=""
       description="its parameters, a YAML mapping string: {kp: 20.0, ki: 4.0}"/>
  <arg name="speed_controller_dt_source" default="loop"
       description="loop (the period update() is called at) or velocity_report"/>
  <arg name="is_simulation" default="false" description="actuator dry run: no PWM"/>

  <!-- the board detector: reflector-pose-init in tracking mode. One scan per
       detection, the board pose in base_link stamped with the scan, published
       only on accepted detections, plus a detection-rate /diagnostics. -->
  <arg name="launch_detector" default="true"/>
  <arg name="detector_launch_file"
       default="$(find-pkg-share reflective_pose_ros)/launch/board_tracking.launch.xml"/>
  <!-- The detector profile and the cloud it reads both follow the LiDAR:
       Robin-W publishes iv_points and uses autosdv_robin_w; the Velodyne
       driver publishes velodyne_points, and the lab's Velodyne is the VLP-16
       (autosdv_vlp16). A vlp32c car has no profile of its own yet; pass
       detector_profile:= explicitly for one. -->
  <let name="lidar_is_robin" value="$(eval &quot;'robin' in '$(var lidar_model)' or ('$(var lidar_model)' == '' and 'robin' in '$(var sensor_suite)')&quot;)"/>
  <let name="detector_profile_default"
       value="$(eval &quot;'autosdv_robin_w' if $(var lidar_is_robin) else 'autosdv_vlp16'&quot;)"/>
  <arg name="detector_profile" default="$(var detector_profile_default)"
       description="reflective_pose_core detector file: autosdv_vlp16 or autosdv_robin_w"/>
  <let name="detector_input_default"
       value="$(eval &quot;'/sensing/lidar/iv_points' if $(var lidar_is_robin) else '/sensing/lidar/velodyne_points'&quot;)"/>
  <arg name="detector_input_topic" default="$(var detector_input_default)"/>

  <arg name="diagnostic_graph_aggregator_graph_path"
       default="$(find-pkg-share autosdv_launch)/config/system/diagnostics/autosdv-pursuit-main.yaml"/>
  <arg name="component_state_monitor_topic_path"
       default="$(find-pkg-share autosdv_launch)/config/system/component_state_monitor/topics-pursuit.yaml"/>

  <!-- AutoSDV stack: sensing, vehicle interface, system, API. rviz is not an
       argument of autosdv.launch.yaml; it reaches autosdv_autoware through the
       launch configuration declared above, the same way `just launch
       rviz:=false` does. -->
  <!-- launch_vehicle_interface is not an autosdv.launch.yaml argument, so
       it reaches the stock vehicle interface only as a launch configuration;
       this let is what switches that one off, and the include below runs the
       lab's. The other switches are plain include arguments (needs
       play_launch >= 0.15; older releases dropped arguments passed from an
       XML include into a YAML launch file). -->
  <let name="launch_vehicle_interface" value="false"/>
  <!-- Sensor-kit switches. Neither autosdv.launch.yaml nor the stock sensing
       component declares them, so these lets are the only way they reach the
       kit. -->
  <let name="launch_pointcloud_preprocessor" value="false"/>
  <let name="launch_vehicle_velocity_converter" value="false"/>
  <let name="launch_gyro_bias_estimator" value="false"/>

  <include file="$(find-pkg-share autosdv_launch)/launch/autosdv.launch.yaml">
    <arg name="sensor_suite" value="$(var sensor_suite)"/>
    <arg name="lidar_model" value="$(var lidar_model)"/>
    <arg name="imu_source" value="$(var imu_source)"/>
    <arg name="camera_model" value="none"/>
    <arg name="use_gnss" value="false"/>
    <arg name="use_ntrip" value="false"/>
    <arg name="launch_map" value="false"/>
    <arg name="launch_localization" value="false"/>
    <arg name="launch_perception" value="false"/>
    <arg name="launch_planning" value="false"/>
    <arg name="launch_control" value="false"/>
    <arg name="launch_system_monitor" value="false"/>
    <arg name="launch_system" value="false"/>
    <arg name="launch_api" value="false"/>
    <arg name="launch_shared_pointcloud_container" value="false"/>
    <arg name="launch_empty_objects_publisher" value="false"/>
    <arg name="is_simulation" value="$(var is_simulation)"/>
  </include>

  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_pursuit_system_component.launch.xml">
    <arg name="run_mode" value="online"/>
    <arg name="diagnostic_graph_aggregator_graph_path" value="$(var diagnostic_graph_aggregator_graph_path)"/>
    <arg name="component_state_monitor_topic_path" value="$(var component_state_monitor_topic_path)"/>
  </include>

  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_pursuit_api_component.launch.xml"/>

  <!-- launch_vehicle_interface is false in this scope (the let above, which
       keeps the stock interface off); this include is the one that runs it. -->
  <include file="$(find-pkg-share autosdv_vehicle_launch)/launch/vehicle_interface.launch.xml">
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="is_simulation" value="$(var is_simulation)"/>
    <arg name="speed_controller_class" value="$(var speed_controller_class)"/>
    <arg name="speed_controller_params" value="$(var speed_controller_params)"/>
    <arg name="speed_controller_dt_source" value="$(var speed_controller_dt_source)"/>
    <!-- The pursuit planner bypasses Autoware planning, so it ignores the
         velocity limit through which a comfortable-stop MRM acts. Brake on
         any MRM instead (the actuator's default is off). -->
    <arg name="emergency_stop_on_any_mrm" value="true"/>
    <!-- The diagnostic graph's converter owns /system/operation_mode/availability.
         control_mode_manager's own always-available copy on the same topic
         would let a failed lab check be overwritten before the MRM handler or
         engage reads it. -->
    <arg name="publish_operation_mode_availability" value="false"/>
    <arg name="launch_signal_manager" value="false"/>
  </include>

  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_dead_reckoning_component.launch.xml">
    <arg name="imu_yaw_sign" value="$(var imu_yaw_sign)"/>
  </include>

  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_pursuit_control_component.launch.xml"/>

  <include file="$(var detector_launch_file)" if="$(var launch_detector)">
    <arg name="profile" value="$(var detector_profile)"/>
    <arg name="input_topic" value="$(var detector_input_topic)"/>
    <arg name="output_topic" value="/perception/coach/board"/>
  </include>

  <include file="$(find-pkg-share autosdv_coach_lab)/launch/coach_pursuit_nodes.launch.xml">
    <arg name="controller_class" value="$(var controller_class)"/>
    <arg name="controller_param_file" value="$(var controller_param_file)"/>
    <arg name="launch_planner" value="$(var launch_planner)"/>
  </include>
</launch>
