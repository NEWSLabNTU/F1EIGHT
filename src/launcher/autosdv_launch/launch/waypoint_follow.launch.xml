<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lab 2: ArUco localization and waypoint following on the vehicle.
  `just lab2 vehicle`.

    ZED left image -> ar_tag_based_localizer -> pose fix ┐
    velocity_report + ZED IMU -> gyro_odometer -> twist ─┴> ekf_localizer
                                                  -> /localization/kinematic_state
    course path.csv -> waypoint_path_publisher -> /planning/trajectory
                    -> path_tracker [the TA's PathTracker] -> control_cmd
                    -> vehicle_cmd_gate -> <vehicle_model>_launch vehicle interface -> PWM

  autosdv.launch.yaml with map, localization, perception, planning, control,
  system and AD API off, and the sensor kit's drivers off (no LiDAR in this
  lab; the kit still provides the ZED's URDF frames and IMU edge). In their
  place:

    zed_aruco.launch.xml                     the ZED: rectified image + IMU only
    aruco_localization.launch.xml            marker map, AR-tag localizer, EKF,
                                             gyro odometer, start_pose_init
    autosdv_pursuit_control_component        the gate, the operation mode
                                             manager, the selector; NOT
                                             trajectory_follower
    autosdv_pursuit_system_component         the diagnostic graph, rate
                                             monitors, MRM handler
    autosdv_pursuit_api_component            ADAPI operation_mode, mrm_request
    waypoint_nodes.launch.xml                path publisher, path_tracker,
                                             localization_monitor
    autosdv-waypoint-main.yaml               the graph: engage needs a marker
                                             fix; a 5 s blind coast or 0.8 m
                                             off the path is an MRM stop

  The vehicle interface runs as in the coach lab (brake on any MRM, the graph
  owns operation-mode availability), plus actuator_param_overrides: the lab's
  steering ratio, which must be MEASURED per car (actuator_lab2.param.yaml).

  Two switches, both defaulting to the car, so Lab 2 Part 1 (the simulated
  car) can run this same stack:

    localization:=ground_truth   no zed_aruco, aruco_localization or
                                 localization_monitor; the graph defaults to
                                 the one without the marker checks. Something
                                 else (rc_sim_plant) publishes
                                 /localization/kinematic_state and TF
                                 map -> base_link. Only with hardware:=sim;
                                 refused on the car.
    hardware:=sim                the actuator on hardware:=sim (the rc_sim
                                 plant's PWM and hall edges), the vehicle
                                 description from tier4_vehicle_launch instead
                                 of autosdv.launch.yaml's sensor kit, the
                                 system component in planning_simulation mode.
                                 With localization:=aruco, something must
                                 provide the camera images or the marker fixes
                                 (as the bench's mock camera or
                                 virtual_marker_localizer do).

  Any other value of either switch refuses to parse, naming the value.

  The rest are parameters a simulated run changes and the car never does:
  path_param_file, vehicle_cmd_gate_param_path, output_emergency_cmd,
  tracker_control_topic, tracker_lockstep, use_sim_time.

  Design: ntu-sdv-course 2026/labs/Lab2/lab2-system-design.md.
  What runs and why: docs/guides/lab2-waypoint-stack.md.
-->
<launch>
  <!-- the car: which instance, then its preset. vehicle_id first, and the preset
       included BEFORE sensor_model, vehicle_model and sensor_suite are declared,
       so the preset's defaults win over this file's and the command line wins
       over both (as autosdv.launch.yaml does; Autoware's model / instance split:
       docs/design/vehicle-variants-and-instances.md). The benches and Part 1 pass
       sim, the simulated nominal car. -->
  <arg name="vehicle_id"
       description="REQUIRED: which car, car_a, car_b or car_c: individual_params/config/VEHICLE_ID (sensor calibration, autosdv_vehicle/actuator.param.yaml, autosdv.preset.yaml)"/>
  <include file="$(find-pkg-share individual_params)/config/$(var vehicle_id)/autosdv.preset.yaml"/>

  <!-- the course -->
  <!-- `route` is the name the Lab 2 handout uses (a "course" reads as a class);
       `course` stays, so older commands keep working. -->
  <arg name="route" default="hall_demo" description="a directory under autosdv_waypoint_lab/config/courses"/>
  <arg name="course" default="$(var route)" description="old name of route"/>
  <arg name="course_dir" default="$(find-pkg-share autosdv_waypoint_lab)/config/courses/$(var course)"
       description="or any course directory, e.g. one surveyed on site"/>
  <arg name="laps" default="0" description="0: the course's own"/>

  <!-- the switches (see the header) -->
  <arg name="localization" default="aruco" description="aruco | ground_truth"/>
  <arg name="hardware" default="car" description="car | sim"/>
  <!-- lookups, not comparisons: a misspelt value is a KeyError naming it, never
       the other stack (hardware:=simulator would otherwise drive real PWM) -->
  <let name="use_aruco"
       value="$(eval &quot;{'localization:=aruco': True, 'localization:=ground_truth': False}['localization:=$(var localization)']&quot;)"/>
  <let name="hardware_sim"
       value="$(eval &quot;{'hardware:=car': False, 'hardware:=sim': True}['hardware:=$(var hardware)']&quot;)"/>
  <!-- on the car nothing publishes the pose without the markers -->
  <let name="switches_ok"
       value="$(eval &quot;'true' if $(var use_aruco) or $(var hardware_sim) else {}['localization:=ground_truth needs hardware:=sim: on the car nothing publishes the pose']&quot;)"/>

  <!-- the car -->
  <arg name="sensor_suite" default="robin_zed" description="autosdv.launch.yaml sensor suite; default: the vehicle_id preset's"/>
  <arg name="rviz" default="false"/>
  <!-- live_view: RViz with the route (white), the trail the localizer has put the car on
       (red) and the marker fixes, on viewer_display; `just lab2 run` turns it on when it
       has a display. The stack itself never has one (the ZED: scripts/camera_display.sh). -->
  <arg name="live_view" default="false"/>
  <arg name="viewer_display" default="$(env DISPLAY '')" description="the X display the live view opens on"/>
  <arg name="actuator_param_overrides"
       default="$(find-pkg-share autosdv_waypoint_lab)/config/actuator_lab2.param.yaml"
       description="the measured steering ratio for this car"/>

  <!-- the path tracker (the TA's) and the speed controller -->
  <arg name="tracker_class" default="autosdv_waypoint_lab.reference.path_tracker:PathTracker"/>
  <arg name="tracker_param_file" default="$(find-pkg-share autosdv_waypoint_lab)/config/path_tracker.param.yaml"/>
  <!-- The vehicle model's own speed controller and tuning by default: the model
       (vehicle_model, below) is the submission, and its vehicle_interface.launch.xml
       picks the class. A class given here is passed on (TA tools, Part 1's
       controller-only runs); empty passes nothing. -->
  <arg name="speed_controller_class" default=""
       description="empty: the vehicle model's own; else package.module:ClassName, passed to the model's vehicle interface"/>
  <arg name="speed_controller_params" default=""
       description="with speed_controller_class only: its parameters, a YAML mapping string: {kp: 20.0, ki: 4.0}"/>
  <arg name="speed_controller_dt_source" default="loop"/>
  <arg name="is_simulation" default="false" description="actuator dry run: no PWM (hardware:=sim ignores it)"/>
  <!-- the models (packages); default: the vehicle_id preset's. vehicle_model is
       Autoware's: <model>_launch/launch/vehicle_interface.launch.xml is the vehicle
       interface, <model>_description the geometry. Lab 2: autosdv_vehicle (the
       reference) or a team's, e.g. team3_vehicle (`just lab2 new-team 3`). -->
  <arg name="vehicle_model" default="autosdv_vehicle"/>
  <arg name="sensor_model" default="autosdv_sensor_kit"/>
  <arg name="use_sim_time" default="false"/>

  <!-- parameter files and topics a simulated run changes; the defaults are the car's -->
  <arg name="path_param_file"
       default="$(find-pkg-share autosdv_waypoint_lab)/config/waypoint_path_publisher.param.yaml"/>
  <arg name="vehicle_cmd_gate_param_path"
       default="$(find-pkg-share autoware_launch)/config/control/vehicle_cmd_gate/vehicle_cmd_gate.param.yaml"
       description="loaded after autoware_launch's; the default is that file again (no change)"/>
  <arg name="output_emergency_cmd" default="/control/command/emergency_cmd"
       description="vehicle_cmd_gate's emergency verdict, which the actuator brakes on"/>
  <arg name="tracker_control_topic" default="/control/trajectory_follower/control_cmd"/>
  <arg name="tracker_lockstep" default="false" description="path_tracker in the simulator's clock handshake"/>

  <!-- Hardware switches, for the vehicle bench (waypoint_follow_bench.launch.xml).
       All default to the car. -->
  <arg name="launch_camera" default="true" description="false: no ZED driver"/>
  <arg name="use_ar_tag_localizer" default="true"
       description="false: something else publishes the marker fixes (the bench's virtual_marker_localizer)"/>
  <arg name="launch_velocity_report" default="true"/>

  <!-- ground_truth: the waypoint graph without the marker checks (Part 1's) -->
  <arg name="diagnostic_graph_aggregator_graph_path"
       default="$(eval &quot;'$(find-pkg-share autosdv_launch)/config/system/diagnostics/autosdv-waypoint-main.yaml' if $(var use_aruco) else '$(find-pkg-share autosdv_waypoint_lab)/config/part1/part1-diagnostics.yaml'&quot;)"/>
  <arg name="component_state_monitor_topic_path"
       default="$(find-pkg-share autosdv_launch)/config/system/component_state_monitor/topics-waypoint.yaml"/>

  <!-- see coach_pursuit.launch.xml for why these four are lets -->
  <let name="launch_vehicle_interface" value="false"/>
  <let name="launch_pointcloud_preprocessor" value="false"/>
  <!-- aruco_localization.launch.xml runs its own, under localization -->
  <let name="launch_vehicle_velocity_converter" value="false"/>
  <let name="launch_gyro_bias_estimator" value="false"/>

  <set_parameter name="use_sim_time" value="true" if="$(var use_sim_time)"/>

  <!-- The kit with its drivers off: no LiDAR, and the ZED driver is
       zed_aruco.launch.xml below. camera_model zedxm keeps the ZED's URDF
       frames and its left camera -> IMU edge (zed_tf_only.launch.xml), and
       stops the kit starting its own IMU-only ZED driver. -->
  <include file="$(find-pkg-share autosdv_launch)/launch/autosdv.launch.yaml" unless="$(var hardware_sim)">
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="sensor_suite" value="$(var sensor_suite)"/>
    <arg name="camera_model" value="zedxm"/>
    <arg name="imu_source" value="zed"/>
    <arg name="use_gnss" value="false"/>
    <arg name="use_ntrip" value="false"/>
    <arg name="launch_map" value="false"/>
    <arg name="launch_localization" value="false"/>
    <arg name="launch_perception" value="false"/>
    <arg name="launch_planning" value="false"/>
    <arg name="launch_control" value="false"/>
    <arg name="launch_system_monitor" value="false"/>
    <arg name="launch_system" value="false"/>
    <arg name="launch_api" value="false"/>
    <arg name="launch_shared_pointcloud_container" value="false"/>
    <arg name="launch_empty_objects_publisher" value="false"/>
    <arg name="launch_sensing_driver" value="false"/>
    <arg name="is_simulation" value="$(var is_simulation)"/>
  </include>

  <!-- hardware:=sim: the vehicle description alone (TF base_link -> sensors),
       and vehicle_info's global parameters, which autosdv.launch.yaml would set
       before the vehicle interface starts -->
  <group scoped="false" if="$(var hardware_sim)">
    <include file="$(find-pkg-share autoware_global_parameter_loader)/launch/global_params.launch.py">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
    </include>
  </group>
  <group if="$(var hardware_sim)">
    <include file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="launch_vehicle_interface" value="false"/>
      <arg name="vehicle_model" value="$(var vehicle_model)"/>
      <arg name="sensor_model" value="$(var sensor_model)"/>
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="config_dir" value="$(find-pkg-share individual_params)/config/$(var vehicle_id)/$(var sensor_model)"/>
    </include>
  </group>

  <let name="launch_zed" value="$(eval &quot;'$(var launch_camera)'.lower() in ('true', '1') and $(var use_aruco)&quot;)"/>
  <include file="$(find-pkg-share autosdv_aruco_localization)/launch/zed_aruco.launch.xml" if="$(var launch_zed)"/>

  <let name="run_mode" value="$(eval &quot;'planning_simulation' if $(var hardware_sim) else 'online'&quot;)"/>
  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_pursuit_system_component.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="run_mode" value="$(var run_mode)"/>
    <arg name="diagnostic_graph_aggregator_graph_path" value="$(var diagnostic_graph_aggregator_graph_path)"/>
    <arg name="component_state_monitor_topic_path" value="$(var component_state_monitor_topic_path)"/>
  </include>

  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_pursuit_api_component.launch.xml"/>

  <!-- sim: the plant is the hardware, so no dry run -->
  <let name="vi_hardware" value="$(eval &quot;'sim' if $(var hardware_sim) else 'real'&quot;)"/>
  <let name="vi_is_simulation" value="$(eval &quot;'false' if $(var hardware_sim) else '$(var is_simulation)'&quot;)"/>
  <!-- the model's vehicle interface; a controller class only when one is given -->
  <let name="vi_launch" value="$(find-pkg-share $(var vehicle_model)_launch)/launch/vehicle_interface.launch.xml"/>
  <let name="vi_own_controller" value="$(eval &quot;'$(var speed_controller_class)' == ''&quot;)"/>
  <!-- through model_vehicle_interface.launch.py, which unsets speed_controller_class and
       _params first: declared here (default ""), they would otherwise leak into the model's
       file and beat its own default class (the actuator's built-in controller would run) -->
  <include file="$(find-pkg-share autosdv_launch)/launch/components/model_vehicle_interface.launch.py"
           if="$(var vi_own_controller)">
    <arg name="vehicle_interface_launch" value="$(var vi_launch)"/>
    <arg name="hardware" value="$(var vi_hardware)"/>
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="is_simulation" value="$(var vi_is_simulation)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="speed_controller_dt_source" value="$(var speed_controller_dt_source)"/>
    <!-- the path publisher bypasses Autoware planning and its velocity limit,
         through which a comfortable-stop MRM acts: brake on any MRM -->
    <arg name="emergency_stop_on_any_mrm" value="true"/>
    <arg name="publish_operation_mode_availability" value="false"/>
    <arg name="launch_signal_manager" value="false"/>
    <arg name="launch_velocity_report" value="$(var launch_velocity_report)"/>
    <arg name="actuator_param_overrides" value="$(var actuator_param_overrides)"/>
  </include>
  <include file="$(var vi_launch)" unless="$(var vi_own_controller)">
    <arg name="hardware" value="$(var vi_hardware)"/>
    <arg name="launch_vehicle_interface" value="true"/>
    <arg name="is_simulation" value="$(var vi_is_simulation)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="speed_controller_class" value="$(var speed_controller_class)"/>
    <arg name="speed_controller_params" value="$(var speed_controller_params)"/>
    <arg name="speed_controller_dt_source" value="$(var speed_controller_dt_source)"/>
    <arg name="emergency_stop_on_any_mrm" value="true"/>
    <arg name="publish_operation_mode_availability" value="false"/>
    <arg name="launch_signal_manager" value="false"/>
    <arg name="launch_velocity_report" value="$(var launch_velocity_report)"/>
    <arg name="actuator_param_overrides" value="$(var actuator_param_overrides)"/>
  </include>

  <!-- with the camera, the localizer runs in its container, so the images
       never go through the network stack -->
  <let name="ar_tag_container" value="/sensing/camera/zedxm/zed_container" if="$(var launch_zed)"/>
  <let name="ar_tag_container" value="" unless="$(var launch_zed)"/>
  <include file="$(find-pkg-share autosdv_aruco_localization)/launch/aruco_localization.launch.xml" if="$(var use_aruco)">
    <arg name="course_dir" value="$(var course_dir)"/>
    <arg name="use_ar_tag_localizer" value="$(var use_ar_tag_localizer)"/>
    <arg name="ar_tag_container" value="$(var ar_tag_container)"/>
  </include>

  <include file="$(find-pkg-share autosdv_aruco_localization)/launch/loc_check.launch.xml" if="$(var live_view)">
    <arg name="course_dir" value="$(var course_dir)"/>
    <arg name="rviz" value="true"/>
    <arg name="viewer_display" value="$(var viewer_display)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <include file="$(find-pkg-share autosdv_launch)/launch/components/autosdv_pursuit_control_component.launch.xml">
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="vehicle_id" value="$(var vehicle_id)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="launch_trajectory_follower" value="false"/>
    <arg name="output_emergency_cmd" value="$(var output_emergency_cmd)"/>
    <arg name="vehicle_cmd_gate_param_path" value="$(var vehicle_cmd_gate_param_path)"/>
  </include>

  <include file="$(find-pkg-share autosdv_waypoint_lab)/launch/waypoint_nodes.launch.xml">
    <arg name="course_dir" value="$(var course_dir)"/>
    <arg name="laps" value="$(var laps)"/>
    <arg name="tracker_class" value="$(var tracker_class)"/>
    <arg name="tracker_param_file" value="$(var tracker_param_file)"/>
    <arg name="path_param_file" value="$(var path_param_file)"/>
    <arg name="vehicle_info_param_file"
         value="$(find-pkg-share $(var vehicle_model)_description)/config/vehicle_info.param.yaml"/>
    <arg name="control_topic" value="$(var tracker_control_topic)"/>
    <arg name="lockstep" value="$(var tracker_lockstep)"/>
    <arg name="launch_localization_monitor" value="$(var use_aruco)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
