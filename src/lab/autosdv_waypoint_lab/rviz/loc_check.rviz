# Lab 2 localization check (just lab2 loc-check): the hall from above.
#   white      the course path (path.csv)
#   red        where the localizer has put the car (the trail)
#   green      the surveyed markers (the localizer's own map)
#   arrows     the latest marker fixes; the car's pose and the camera view
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 80; 80; 80
      Reference Frame: map
    - Class: rviz_default_plugins/Path
      Name: Course path
      Enabled: true
      Color: 255; 255; 255
      Line Style: Billboards
      Line Width: 0.04
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lab2/course_path
    - Class: rviz_default_plugins/Path
      Name: Trail (localized)
      Enabled: true
      Color: 255; 60; 60
      Line Style: Billboards
      Line Width: 0.03
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lab2/trail
    - Class: rviz_default_plugins/MarkerArray
      Name: Markers (survey)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization/pose_estimator/ar_tag_based_localizer/debug/mapped_tag
    - Class: rviz_default_plugins/PoseArray
      Name: Marker fixes
      Enabled: true
      Color: 60; 220; 60
      Shape: Arrow (Flat)
      Arrow Length: 0.3
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lab2/fixes
    - Class: rviz_default_plugins/Odometry
      Name: Car (EKF)
      Enabled: true
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 200; 0
        Shaft Length: 0.5
        Shaft Radius: 0.04
        Head Length: 0.15
        Head Radius: 0.08
      Covariance:
        Value: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /localization/kinematic_state
    - Class: rviz_default_plugins/Image
      Name: Camera (detections)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /localization/pose_estimator/ar_tag_based_localizer/debug/image
  Enabled: true
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 3
      Y: 1
      Angle: 0
      Target Frame: map
Window Geometry:
  Width: 1400
  Height: 900
