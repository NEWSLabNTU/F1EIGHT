<launch>
  <arg name="course_dir"/>
  <arg name="localizer" default="marker" description="marker (marker_localizer) or ar_tag"/>
  <group><push-ros-namespace namespace="map"/>
    <node pkg="autoware_map_projection_loader" exec="autoware_map_projection_loader_node" name="map_projection_loader">
      <param name="map_projector_info_path" value="$(var course_dir)/map_projector_info.yaml"/>
      <param name="lanelet2_map_path" value="$(var course_dir)/lanelet2_map.osm"/>
    </node>
    <node pkg="autoware_map_loader" exec="autoware_lanelet2_map_loader" name="lanelet2_map_loader">
      <param name="allow_unsupported_version" value="true"/>
      <param name="center_line_resolution" value="5.0"/>
      <param name="use_waypoints" value="true"/>
      <param name="lanelet2_map_path" value="$(var course_dir)/lanelet2_map.osm"/>
      <remap from="output/lanelet2_map" to="vector_map"/>
    </node>
  </group>
  <!-- the stack's own localizer launch file, on the fake camera -->
  <include file="$(find-pkg-share autosdv_waypoint_lab)/launch/marker_localizer.launch.xml"
           if="$(eval &quot;'$(var localizer)' == 'marker'&quot;)">
    <arg name="course_dir" value="$(var course_dir)"/>
    <arg name="image_topic" value="/fake/image"/>
    <arg name="camera_info_topic" value="/fake/camera_info"/>
    <arg name="detect_scale" value="$(env DETECT_SCALE 0.5)"/>
  </include>
  <group if="$(eval &quot;'$(var localizer)' == 'ar_tag'&quot;)"><push-ros-namespace namespace="localization/pose_estimator"/>
    <node pkg="autoware_ar_tag_based_localizer" exec="autoware_ar_tag_based_localizer_node"
          name="ar_tag_based_localizer" output="both">
      <remap from="~/input/lanelet2_map" to="/map/vector_map"/>
      <remap from="~/input/image" to="/fake/image"/>
      <remap from="~/input/camera_info" to="/fake/camera_info"/>
      <remap from="~/input/ekf_pose" to="/localization/pose_twist_fusion_filter/biased_pose_with_covariance"/>
      <remap from="~/output/pose_with_covariance" to="/localization/pose_estimator/pose_with_covariance"/>
      <param from="$(find-pkg-share autosdv_waypoint_lab)/config/ar_tag_based_localizer.param.yaml"/>
      <param from="$(var course_dir)/ar_tag.param.yaml" allow_substs="true"/>
    </node>
  </group>
</launch>
