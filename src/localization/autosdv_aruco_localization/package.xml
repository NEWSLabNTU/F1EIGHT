<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_aruco_localization</name>
  <version>0.1.0</version>
  <description>
    ArUco localization on a surveyed marker map: the map files (course.yaml to
    a lanelet2 marker map and the localizer's settings), the launch that wires
    the ZED, Autoware's AR-tag localizer and EKF, start_pose_init, the
    localization check (loc_check) and the camera check, and two stand-ins for
    the camera (mock_aruco_camera, virtual_marker_localizer) for testing
    without a car. Lab-independent: autosdv_marker_survey writes its maps, and
    Lab 2 (autosdv_waypoint_lab) builds on it.
  </description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- the localization aruco_localization.launch.xml wires up -->
  <exec_depend>autoware_ar_tag_based_localizer</exec_depend>
  <exec_depend>autoware_ekf_localizer</exec_depend>
  <exec_depend>autoware_gyro_odometer</exec_depend>
  <exec_depend>autoware_vehicle_velocity_converter</exec_depend>
  <exec_depend>autoware_twist2accel</exec_depend>
  <exec_depend>autoware_map_loader</exec_depend>
  <exec_depend>autoware_map_projection_loader</exec_depend>
  <exec_depend>autoware_launch</exec_depend>
  <!-- zed_aruco.launch.xml -->
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>zed_components</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
